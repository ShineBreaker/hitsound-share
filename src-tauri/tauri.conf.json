{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "hitsound-share",
	"mainBinaryName": "hitsound-share",
	"version": "0.1.0",
	"identifier": "dev.hitsound.share",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "",
		"frontendDist": "../build-static"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "hitsound 分享站",
				"width": 1280,
				"height": 800,
				"minWidth": 960,
				"minHeight": 600,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; connect-src 'self' https: blob: ipc: http://ipc.localhost; media-src 'self' blob: https: data:; img-src 'self' https: data:; object-src 'none'; base-uri 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["deb"],
		"category": "Music",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
