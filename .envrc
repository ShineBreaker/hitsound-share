# --- denv managed ---
use guix
# --- end denv managed ---

# --- hitsound-share 开发依赖（guix manifest + corepack 提供 pnpm + 本地 bin）---
# Node 等来自 manifest.scm（大版本与 .node-version 一致）；denv 段照旧注入用户 profile
watch_file manifest.scm
watch_file package.json
use guix -m manifest.scm

# pnpm 由 corepack 提供下载（guix 未收录 pnpm；guix store 只读无法 enable 到系统路径）。
# 注意：node 22 自带的 corepack 0.31 dispatcher 不识别 pnpm 12 的入口布局
# （bin/pnpm.cjs 已不存在），因此不经 corepack shim 转发，直接 symlink 到
# corepack 下载好的 pnpm 自举入口；版本取自 package.json 的 packageManager
export COREPACK_HOME="${PWD}/.cache/corepack"
PNPM_VER="$(node -p 'require("./package.json").packageManager.split("@")[1]')"
corepack prepare "pnpm@${PNPM_VER}" --activate >/dev/null 2>&1 || true
mkdir -p .cache/bin
# 包装入口 pnpm 是无 shebang 的自举脚本（direnv exec / execvp 无法直接执行），
# 经 node 直启 bin/pnpm.mjs；PNPM_VER 在此展开，COREPACK_HOME 运行时取
cat > .cache/bin/pnpm <<WRAP
#!/bin/sh
exec node "\${COREPACK_HOME}/v1/pnpm/${PNPM_VER}/bin/pnpm.mjs" "\$@"
WRAP
chmod +x .cache/bin/pnpm
PATH_add .cache/bin

# 项目本地依赖（wrangler 等；pnpm install 之后可用）
PATH_add node_modules/.bin
