# 复制为 .env 并填写（.env 已被 gitignore，不会入库）

# Cloudflare 账号（R2 S3 endpoint 用）
R2_ACCOUNT_ID=

# R2 API Token（面板 Create API Token → Object Read & Write → 限定 hitsound-files 桶）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# osu! OAuth 客户端（部署拿到 pages.dev 子域名后在 osu.ppy.sh/home/account/edit#oauth 注册）
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# 可选：显式 OAuth 回调地址（不填则默认取请求 origin + /api/auth/callback，
# pages.dev 与本地 5173 都能自动适配）
OSU_REDIRECT_URI=

# 会话 cookie 的 HMAC 签名密钥（生成：openssl rand -hex 32；部署时须配到 Pages 环境变量）
SESSION_SECRET=

# 超级管理员的 osu! 用户 ID（数字）：唯一可维护管理员名单的人；
# 更多管理员由其在站顶栏「管理员」面板中添加（users.is_admin，限已登录用户）
ADMIN_OSU_ID=
